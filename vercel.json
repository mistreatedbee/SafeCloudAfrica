{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/functions/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/email/send",
      "destination": "/api/email/send"
    },
    {
      "source": "/api/invites/create",
      "destination": "/api/invites/create"
    },
    {
      "source": "/api/invites/validate",
      "destination": "/api/invites/validate"
    },
    {
      "source": "/api/invites/validate/(.*)",
      "destination": "/api/invites/validate/$1"
    },
    {
      "source": "/api/invites/accept",
      "destination": "/api/invites/accept"
    },
    {
      "source": "/api/invites/resend",
      "destination": "/api/invites/resend"
    },
    {
      "source": "/api/client-log",
      "destination": "/api/client-log"
    },
    {
      "source": "/api/cron/heartbeat",
      "destination": "/api/cron/heartbeat"
    },
    {
      "source": "/api/health/insforge-db",
      "destination": "/api/health/insforge-db"
    },
    {
      "source": "/api/documents/editor-config",
      "destination": "/api/documents/editor-config"
    },
    {
      "source": "/api/documents/file",
      "destination": "/api/documents/file"
    },
    {
      "source": "/api/documents/onlyoffice/callback",
      "destination": "/api/documents/onlyoffice/callback"
    },
    {
      "source": "/api/auth/sessions/current",
      "destination": "https://pas375jb.us-west.insforge.app/api/auth/sessions/current"
    },
    {
      "source": "/api/auth/logout",
      "destination": "https://pas375jb.us-west.insforge.app/api/auth/logout"
    },
    {
      "source": "/api/database/rpc/(.*)",
      "destination": "https://pas375jb.us-west.insforge.app/api/database/rpc/$1"
    },
    {
      "source": "/api/database/records/(.*)",
      "destination": "https://pas375jb.us-west.insforge.app/api/database/records/$1"
    },
    {
      "source": "/api/_insforge-proxy/(.*)",
      "destination": "/api/_insforge-proxy"
    },
    {
      "source": "/api/_insforge-functions/(.*)",
      "destination": "/api/_insforge-functions"
    },
    {
      "source": "/functions/(.*)",
      "destination": "/api/_insforge-functions?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/_insforge-proxy?path=$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 0 * * *"
    }
  ]
}
