{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/functions/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/email/send",
      "destination": "/api/email/send"
    },
    {
      "source": "/api/invites/(.*)",
      "destination": "/api/invites-router?action=$1"
    },
    {
      "source": "/api/client-log",
      "destination": "/api/client-log"
    },
    {
      "source": "/api/cron/heartbeat",
      "destination": "/api/cron/heartbeat"
    },
    {
      "source": "/api/cron/send-monthly-safety-report",
      "destination": "/api/cron/generate-monthly-report"
    },
    {
      "source": "/api/health/insforge-db",
      "destination": "/api/health/insforge-db"
    },
    {
      "source": "/api/documents/:path*",
      "destination": "/api/documents?slug=:path*"
    },
    {
      "source": "/api/database/rpc/(.*)",
      "destination": "/api/insforge-proxy?path=database/rpc/$1"
    },
    {
      "source": "/api/database/records/(.*)",
      "destination": "/api/insforge-proxy?path=database/records/$1"
    },
    {
      "source": "/api/_insforge-proxy/(.*)",
      "destination": "/api/insforge-proxy?path=$1"
    },
    {
      "source": "/api/_insforge-functions/(.*)",
      "destination": "/api/insforge-functions?path=$1"
    },
    {
      "source": "/functions/(.*)",
      "destination": "/api/insforge-functions?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/insforge-proxy?path=$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/generate-monthly-report",
      "schedule": "0 7 1 * *"
    }
  ]
}
