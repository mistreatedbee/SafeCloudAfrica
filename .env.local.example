
VITE_API_MODE=insforge

# PAAQ Intelligence — product analytics & observability
# Get these from your PAAQ dashboard's Connect page — never share/commit real values
VITE_PAAQ_SDK_TOKEN=REPLACE_WITH_YOUR_PAAQ_SDK_TOKEN
VITE_PAAQ_PROJECT_KEY=REPLACE_WITH_YOUR_PAAQ_PROJECT_KEY

# InsForge Configuration
# Get these from your InsForge project dashboard (Settings → API Keys)
VITE_INSFORGE_BASE_URL=https://pas375jb.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# Vercel / server only (not VITE_): operational events + cron heartbeat
# PAAQ_SDK_TOKEN=             # optional override for server-side PAAQ calls (api/_paaq.ts); falls back to VITE_PAAQ_SDK_TOKEN
# PAAQ_PROJECT_KEY=           # optional override for server-side PAAQ calls (api/_paaq.ts); falls back to VITE_PAAQ_PROJECT_KEY
# INSFORGE_SERVICE_ROLE_KEY=  # required for platform events and ONLYOFFICE callback save flow
# ALERT_WEBHOOK_URL=          # optional JSON webhook for email/invite/cron failures
# CRON_SECRET=                # required for /api/cron/heartbeat (Vercel cron sends Bearer)
# INVITE_SIGNING_SECRET=      # recommended: stable HMAC secret for invite links

# ONLYOFFICE (Document editor) - required for real-time Word/Excel editing
# Deploy ONLYOFFICE Docs separately and configure JWT on the doc server.
# ONLYOFFICE_DOCSERVER_ORIGIN=https://onlyoffice.yourdomain.com
# ONLYOFFICE_JWT_SECRET=REPLACE_WITH_ONLYOFFICE_JWT_SECRET
# DMS_FILE_ACCESS_JWT_SECRET=REPLACE_WITH_APP_FILE_TOKEN_SECRET  # optional; falls back to ONLYOFFICE_JWT_SECRET
# APP_PUBLIC_ORIGIN=https://your-frontend-domain.com             # recommended; inferred from request headers if unset

# Debug Mode (false for production)
VITE_SHOW_ENV_DEBUG=false

# Optional: Demo seeding (disable in production)
VITE_ENABLE_DEMO_SEED=false
VITE_DEMO_SEED_TOKEN=CHANGE_ME

# Optional: Super-admin Platform health — declared last backup verification (ISO 8601). Redeploy after updates.
# Overrides only when no platform_operational_events row exists with event_type backup.verified (see docs/BACKUP-AND-RESTORE.md).
# VITE_PLATFORM_LAST_BACKUP_DECLARED_AT=2026-03-21T12:00:00.000Z

# Optional: Clickable backup runbook URL for super-admin UI (e.g. GitHub blob link to docs/BACKUP-AND-RESTORE.md).
# VITE_BACKUP_RUNBOOK_URL=https://github.com/ORG/REPO/blob/main/docs/BACKUP-AND-RESTORE.md
