VITE_API_MODE=insforge

# InsForge (public)
# Use anon key in frontend (safe to expose). Never put admin API keys in Vite env vars.
VITE_INSFORGE_BASE_URL=https://pas375jb.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# Optional UI debug for deployments (keep false in production)
VITE_SHOW_ENV_DEBUG=false

# Demo seeding (for staging/demo only; disable for production)
VITE_ENABLE_DEMO_SEED=false
VITE_DEMO_SEED_TOKEN=CHANGE_ME

