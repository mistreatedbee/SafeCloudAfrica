VITE_API_MODE=insforge

# Browser / Vite build — required for the app to reach InsForge
VITE_INSFORGE_BASE_URL=https://your-project.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# Optional: override Vite dev proxy target only (defaults to VITE_INSFORGE_BASE_URL)
# INSFORGE_DEV_PROXY_TARGET=https://your-project.us-west.insforge.app

# Public app URL for invite links and server fallbacks (Vercel sets VERCEL_URL automatically; hostname only)
# APP_URL=https://your-app.vercel.app
# VITE_APP_URL=https://your-app.vercel.app

VITE_SHOW_ENV_DEBUG=false

VITE_ENABLE_DEMO_SEED=false
VITE_DEMO_SEED_TOKEN=SD67672026

# --- Server-side (Vercel / api/*) — prefer INSFORGE_* without VITE_ prefix on the server
# INSFORGE_BASE_URL=https://your-project.us-west.insforge.app
# INSFORGE_ANON_KEY=same_as_or_server_copy_of_anon_key
# INSFORGE_SERVICE_ROLE_KEY=service_role_for_platform_operational_events_etc

# Email — see api/email/send.ts
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# InsForge Edge cron jobs that call this app’s email API — see scripts/insforge-functions/*.js
# EMAIL_API_URL=https://your-app.vercel.app/api/email/send

# Ops / webhooks — see api/_observability.ts and api/cron/heartbeat.ts
# ALERT_WEBHOOK_URL=https://hooks.example.com/alert
# CRON_SECRET=long_random_string_for_cron_auth

# Logging: API routes emit JSON lines to stdout (Vercel function logs). Optional failure alerts: ALERT_WEBHOOK_URL.
